{
  "name": "payledger",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Digital wallet and payments platform: double-entry ledger, row-level locking, idempotent payments, rotating sessions, 2FA, refunds, payment requests, Razorpay, audit log and observability.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --watch server/src/server.js",
    "start": "node server/src/server.js",
    "migrate": "node server/scripts/migrate.js",
    "seed": "node server/scripts/seed.js",
    "reconcile": "node server/scripts/reconcile.js",
    "race-demo": "node server/scripts/race-demo.js",
    "benchmark": "node server/scripts/benchmark.js",
    "test": "vitest run",
    "web:dev": "npm --prefix web run dev",
    "build": "npm --prefix web run build",
    "cleanup": "node server/scripts/cleanup.js",
    "make-admin": "node server/scripts/make-admin.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.24.6",
    "pdfkit": "^0.20.2",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "prom-client": "^15.1.3",
    "rate-limit-redis": "^6.0.2",
    "swagger-ui-express": "^5.0.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "supertest": "^7.3.2",
    "vitest": "^5.1.0"
  }
}
