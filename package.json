{
  "name": "payledger",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Digital wallet and payments API with a double-entry ledger, row-level locking and idempotent payments.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --watch server/src/server.js",
    "start": "node server/src/server.js",
    "migrate": "node server/scripts/migrate.js",
    "seed": "node server/scripts/seed.js",
    "reconcile": "node server/scripts/reconcile.js",
    "race-demo": "node server/scripts/race-demo.js",
    "benchmark": "node server/scripts/benchmark.js",
    "test": "vitest run",
    "web:dev": "npm --prefix web run dev",
    "build": "npm --prefix web run build"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.24.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "supertest": "^7.3.2",
    "vitest": "^5.1.0"
  }
}
