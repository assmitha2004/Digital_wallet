# ---- Required --------------------------------------------------------------------------------
# MySQL connection string
DATABASE_URL=mysql://root:root@localhost:3306/payledger
# Long random string, e.g. `openssl rand -base64 48`
JWT_SECRET=change-me

# ---- Database --------------------------------------------------------------------------------
# Hosted MySQL (TiDB, Aiven, ...): DB_SSL=true, and DB_CA_CERT = the CA certificate text if the provider gives one
DB_SSL=false
DB_CA_CERT=
DB_POOL_SIZE=10

# ---- Sessions and security ------------------------------------------------------------------
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
# Secure cookies need HTTPS. Defaults to true when NODE_ENV=production.
COOKIE_SECURE=false
MAX_FAILED_LOGINS=5
LOCK_MINUTES=15
# Transfers at or above this many rupees need a 2FA code
STEP_UP_THRESHOLD_RUPEES=10000
# Promoted to ADMIN by `npm run seed` (never use the public demo account here)
ADMIN_EMAIL=

# ---- Rate limiting ---------------------------------------------------------------------------
# Optional. With Redis, limits are shared across all instances; without it, per process.
REDIS_URL=
# on / off (default: on, except in tests)
RATE_LIMITS=on
RATE_LIMIT_API_PER_MINUTE=300
RATE_LIMIT_PAYMENTS_PER_MINUTE=30

# ---- Operations ------------------------------------------------------------------------------
LOG_LEVEL=info
# Required to read /api/metrics in production
METRICS_TOKEN=
# Vercel Cron sends this as a Bearer token to /api/internal/cleanup
CRON_SECRET=
IDEMPOTENCY_KEY_TTL_HOURS=24

# ---- Payments --------------------------------------------------------------------------------
# Simulated top-ups for demos (set false in a real deployment)
ALLOW_SIMULATED_TOPUPS=true
# Razorpay test-mode keys from https://dashboard.razorpay.com (Settings -> API Keys, Webhooks)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

PORT=4000
