# MySQL connection string
DATABASE_URL=mysql://root:root@localhost:3306/payledger
# Long random string, e.g. `openssl rand -base64 48`
JWT_SECRET=change-me
# Hosted MySQL (Aiven etc.): set DB_SSL=true, and DB_CA_CERT to the CA certificate text if the provider gives one
DB_SSL=false
DB_CA_CERT=
# Optional
JWT_EXPIRES_IN=2h
DB_POOL_SIZE=10
PORT=4000
